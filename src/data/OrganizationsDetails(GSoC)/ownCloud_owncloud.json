  "projects": {
    "2016": [
      {
        "title": "ownCloud App for metadata extraction from Images and Introducing Photo Calendar in Gallery",
        "short_description": "Project Idea: Create an ownCloud app which provides CRUD access to the metadata stored in images.\nImages can contain extra information embedded in...",
        "description": "<p>Project Idea: Create an <strong>ownCloud</strong> app which provides CRUD access to the <strong>metadata</strong> stored in images.</p>\n<p>Images can contain extra information embedded in the header (<a href=\"https://github.com/owncloud/gallery/issues/550\" target=\"_blank\">#550</a>). The goal is to extract that information at upload time and to store it in the database so that it can be used later. The aim of this project is to use the extracted information for implementing Sorting by different attributes(such as date taken, color, size, person) and also for creating multiple views in Gallery. The different views that I have thought of are:</p>\n<ul>\n<li><strong>Photo Calendar</strong> (Multiple views: Year, Month, Day) (Proposed) <strong>(Highest Preference)</strong></li>\n<li><strong>Location View</strong> (Based on the location) (Proposed)</li>\n</ul>\n",
        "student_name": "imjalpreet",
        "code_url": "https://github.com/interfasys/mediametadata",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5700479237488640/"
      },
      {
        "title": "ownCloud Demo Improvements",
        "short_description": "Improve ownCloud Community services for performance, security and monitoring for development purposes. This includes a move to a Kubernetes based...",
        "description": "<p>Improve ownCloud Community services for performance, security and monitoring for development purposes. This includes a move to a Kubernetes based container system using one container per user for an optimal and privacy aware demo experience.</p>\n",
        "student_name": "Michael Grosser (stp)",
        "code_url": "https://s.stp-ip.net/GSoC16",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5532391397392384/"
      }
    ],
    "2017": [
      {
        "title": "Security App",
        "short_description": "ownCloud Security app. It hardens ownCloud security with several new features including brute force protection, 404 detection and strong password...",
        "description": "<p>ownCloud Security app. It hardens ownCloud security with several new features including brute force protection, 404 detection and strong password enforcement.</p>\n",
        "student_name": "Semih Serhat Karakaya",
        "code_url": "https://gist.github.com/karakayasemi/99dce25f33afcf15ddc2622272d5066b",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6178886249349120/"
      },
      {
        "title": "Dropbox API v2 Integration",
        "short_description": "This project aims to integrate the Version 2 of the Dropbox API in OwnCloud which currently uses the v1 of the Dropbox API which has been deprecated...",
        "description": "<p>This project aims to integrate the Version 2 of the Dropbox API in OwnCloud which currently uses the v1 of the Dropbox API which has been deprecated by Dropbox and all the endpoints will be turned off on June 28, 2017. The project will include swapping out the v1 PHP SDK with v2 but since Dropbox have not launched any official PHP SDK for the API v2 one of the Community SDK (as mentioned on the Dropbox Developer Documentation <a href=\"https://www.dropbox.com/developers/documentation/communitysdks\" target=\"_blank\">here</a> ) can be used for the same.</p>\n",
        "student_name": "hemant-mann",
        "code_url": "https://github.com/owncloud/files_external_dropbox/pull/1",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/4844054437167104/"
      },
      {
        "title": "ownCloud as a backend for web apps",
        "short_description": "The aim of this project is to make support for cross-origin API access in ownCloud using OAuth2 verification AND ​write a JavaScript API Client...",
        "description": "<p>The aim of this project is to make support for cross-origin API access in ownCloud using OAuth2 verification AND ​write a JavaScript API Client library making it easy for the developers to communicate with existent ownCloud APIs.</p>\n",
        "student_name": "Noveen Sachdeva",
        "code_url": "https://gist.github.com/noveens/381b12c830d1b77b99877943f90ebb1b",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5166409181036544/"
      }
    ]
  },
