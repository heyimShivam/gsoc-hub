  ],
  "projects": {
    "2017": [
      {
        "title": "Collect - Improved user experience",
        "short_description": "User Interface is considered as the most crucial success factor for any software. As we already know, the user interface of the current app is...",
        "description": "<p>User Interface is considered as the most crucial success factor for any software. As we already know, the user interface of the current app is outdated (not updated since 2008) and not at all according to the expected standards of users. So the community feels that through this project the complete UI/UX of the app can be revamped so that it could provide a fresh experience to the users and make the task of collecting data easier and more intuitive.</p>\n",
        "student_name": "Shobhit Agarwal",
        "code_url": "https://medium.com/@shobhitagarwal1612/gsoc-2017-with-opendatakit-5448f927409",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6496885627944960/"
      }
    ],
    "2018": [
      {
        "title": "Supervisor app - Device to Device Transfer Android Application",
        "short_description": "The common requirement of Collect users is to share forms between devices. This is important for forms that need to be filled out in multiple steps...",
        "description": "<p>The common requirement of Collect users is to share forms between devices. This is important for forms that need to be filled out in multiple steps by different enumerators. And sometimes form need some review before actually getting submitted to the server. A supervisor will be able to review the forms and upload the good ones and send back the bad ones for improvement. So this project will allow enumerators to share partially/completely filled forms with each other and also help supervisor in reviewing the forms. The main focus of this project is to see the pros/cons of different communication strategies possible in Android devices and select the one which is both robust and reliable.</p>\n",
        "student_name": "Lakshya Gupta",
        "code_url": "https://forum.opendatakit.org/t/gsoc-2018-share-a-device-to-device-form-transfer-app/14559",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/6451359847022592/"
      },
      {
        "title": "ODK 2 Services - Push Notifications",
        "short_description": "The primary aim of the project is to create an android application for field workers that would receive push notifications sent by their supervisors....",
        "description": "<p>The primary aim of the project is to create an android application for field workers that would receive push notifications sent by their supervisors. The android application would communicate with ODK Service for authentication. Another important aim of the project is to build a standalone Java application through which supervisors can push notifications to their field workers.</p>\n",
        "student_name": "Aditya Laddha",
        "code_url": "https://medium.com/@laddha.adi/gsoc-2018-with-open-data-kit-d2379fb3050c",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/4826369305346048/"
      }
    ],
    "2019": [
      {
        "title": "Stabilize and release ODK 2 Push Notifications",
        "short_description": "ODK 2 Push Notification enables supervisors to send notification to field workers with the help of skunkworks-parrot (Desktop Application) and...",
        "description": "<p>ODK 2 Push Notification enables supervisors to send notification to field workers with the help of skunkworks-parrot (Desktop Application) and workers receive notification in a Android application named ‘skunkworks-bat’. It facilitates larger organisation to manage their working groups efficiently. First aim of the project is to stabilize and test both the applications so that they can be fully released and integrated into the ODK 2 tool suite. Second major improvement which I propose is to add interactive notification along with some minor improvements.</p>\n",
        "student_name": "Harsh Gupta",
        "code_url": "https://medium.com/@guptaharsh615/gsoc19-with-open-data-kit-fce5532c474e",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/5091786437951488/"
      },
      {
        "title": "Strategy to Increase Devices Supported and Validate Application Behavior",
        "short_description": "Now, we have skunkworks-crow, which is the GSoC 2018 project. In this year, we need to improve the project and develop a new strategy to address the...",
        "description": "<p>Now, we have skunkworks-crow, which is the GSoC 2018 project. In this year, we need to improve the project and develop a new strategy to address the highest-value limiting factors to broaden the base, and propose a strategy to validate behavior on devices we may not have access to.</p>\n",
        "student_name": "Yizheng Huang",
        "code_url": "https://forum.opendatakit.org/t/gsoc-2019-strategy-to-increase-devices-supported-and-validate-application-behavior/21657",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/4696810055008256/"
      }
    ]
  },
