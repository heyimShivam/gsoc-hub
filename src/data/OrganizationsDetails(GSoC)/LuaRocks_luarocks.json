  "projects": {
    "2017": [
      {
        "title": "Social Enhancements for LuaRocks",
        "short_description": "LuaRocks is a package manager for Lua modules, it's the home of hundreds of modules and a place where developers find and host them.\nCurrently,...",
        "description": "<p>LuaRocks is a package manager for Lua modules, it's the home of hundreds of modules and a place where developers find and host them.</p>\n<p>Currently, LuaRocks doesn't offer features to allow users to have much interaction as a community besides  following modules. There are some examples over the Internet of platforms that host code but also gives a social experience to the users, giving them the opportunity to better interact with the community and the code, which ends up encouraging users to be more participative and contribute.</p>\n",
        "student_name": "Jeferson Lesbão Siqueira",
        "code_url": "https://randstructure.wordpress.com/2017/08/23/gsoc-17-the-last-week/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/4764164690018304/"
      }
    ],
    "2018": [
      {
        "title": "LuaRocks-GUI",
        "short_description": "LuaRocks is a package manager for Lua. This project will provide a web based GUI front-end for LuaRocks that would allow users to search for rocks,...",
        "description": "<p>LuaRocks is a package manager for Lua. This project will provide a web based GUI front-end for LuaRocks that would allow users to search for rocks, list installed rocks, install and remove them, view rock details, etc., which would use an API for interfacing with the LuaRocks back-end.</p>\n",
        "student_name": "jiteshpabla",
        "code_url": "https://bystanderguy.wordpress.com/2018/08/10/gsoc18-with-luarocks-final-submission/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/6618388709244928/"
      },
      {
        "title": "Unit Tests for LuaRocks",
        "short_description": "The goal of this project is to produce a unit test suite for LuaRocks in order to improve the code coverage and to increase the maintainability of...",
        "description": "<p>The goal of this project is to produce a unit test suite for LuaRocks in order to improve the code coverage and to increase the maintainability of the project.</p>\n",
        "student_name": "George Roman",
        "code_url": "https://gist.github.com/georgeroman/46a1c29be36d3f1d4e543e0a6d2f051c",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5388394699948032/"
      }
    ],
    "2019": [
      {
        "title": "Lua graphing library",
        "short_description": "To create a graphical library possibly using IUP extensible by Lua to allow easy creation of software like a schematic editor/flowchart creator/mind...",
        "description": "<p>To create a graphical library possibly using IUP extensible by Lua to allow easy creation of software like a schematic editor/flowchart creator/mind maps/block diagrams in Lua. The library needs to create basic mechanisms and graphic checks to create custom blocks and interconnections and provide an API to use these to create complex interactions like hierarchical schematic editors, etc.</p>\n",
        "student_name": "Deepak Singh Rathore",
        "code_url": "https://github.com/Deepak123bharat/lua-gl/wiki/GSoC-2019-work-Product-Submission",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/4613493980921856/"
      },
      {
        "title": "New command line argument handling and auto-completion for LuaRocks",
        "short_description": "This project will bring tab completion support to LuaRocks and any Lua project using the argparse command line parser. Support for generating...",
        "description": "<p>This project will bring tab completion support to LuaRocks and any Lua project using the argparse command line parser. Support for generating completion scripts for popular shells will be implemented in argparse. LuaRocks will be updated to use argparse for command line argument handling.</p>\n",
        "student_name": "Paul Ouellette",
        "code_url": "https://gist.github.com/pauloue/f403e542338f96ae4ac2aa47c266cb5d",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/4659615638224896/"
      }
    ]
  },
