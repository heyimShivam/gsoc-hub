  "projects": {
    "2018": [
      {
        "title": "Suggestions sorting improvement, migration to the modern server-side framework, migration from Maven to Gradle",
        "short_description": "During the GSoC I'm going to complete the following tasks:\n\nEnhance the suggestions sorting algorithm using the ML-way inspired by after the...",
        "description": "<p>During the GSoC I'm going to complete the following tasks:</p>\n<ol>\n<li>Enhance the suggestions sorting algorithm using the ML-way inspired by <a href=\"https://open.afterthedeadline.com/about/technology-overview\" target=\"_blank\">after the deadline</a>'s (section \"The Spelling Corrector\")</li>\n<li>Migrate the server-side of the LanguageTool to the modern lightweight framework</li>\n<li>Migrate the LanguageTool from Maven to Gradle</li>\n</ol>\n",
        "student_name": "Oleg Serikov",
        "code_url": "https://forum.languagetool.org/t/gsoc-reports-spellchecker-server-side-framework-and-build-tool-tasks/2926/43?u=oserikov",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5696068708728832/"
      },
      {
        "title": "Confusion Pair Correction Using Sequence to Sequence Models",
        "short_description": "LanguageTool (LT) currently uses neural networks to detect confusion between words. So far, it only considers 2 words of context in both directions...",
        "description": "<p>LanguageTool (LT) currently uses neural networks to detect confusion between words. So far, it only considers 2 words of context in both directions (tri-grams). The aim of this project is to extend this to take the entire sentence as context to detect the confusion pairs. For this, the project aims to leverage the use of a sequence-to-sequence model to detect the word(s) that are used incorrectly and then replace them with the correct word(s). The project aims to give this functionality to English, French, and German.</p>\n",
        "student_name": "Allen Antony",
        "code_url": "https://github.com/drexjojo/confusion_pair_correction",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/4932015702933504/"
      }
    ]
  },
