  "projects": {
    "2017": [
      {
        "title": "Advertisement management extension",
        "short_description": "The ability to easily handle advertisements in phpBB is often requested. Latest pool for next official extension results in Advertisement Management...",
        "description": "<p>The ability to easily handle advertisements in phpBB is often requested. <a href=\"https://www.phpbb.com/community/viewtopic.php?f=64&amp;t=2314201\" target=\"_blank\">Latest pool for next official extension</a> results in Advertisement Management being tightly at the second position, while it’s <a href=\"https://www.phpbb.com/community/viewtopic.php?f=496&amp;t=2255691\" target=\"_blank\">extension request topic</a> is far more active (with 126 replies and almost 8000 views) than pool’s winner Paypal Donations (which <a href=\"https://www.phpbb.com/customise/db/extension/paypal_donation_extension/\" target=\"_blank\">already exists</a>). <a href=\"https://www.phpbb.com/customise/db/mod/advertisement_management/\" target=\"_blank\">EXreaction’s modification</a> is 9th most downloaded MOD with more than 66000 downloads. Clearly, there is a big demand for this extension.</p>\n<p>My goal will be creating an advertisement management extension that allows admins to add HTML/JS advertisement code to number of locations in the template. If time allows, many additional features will be implemented, i.e. end date, hide ad for specific groups, adblocker friendly message, ad priority, views and clicks counting, ad owners, banner uploads, extensible and/or additional template locations and PHP event hooks for other extensions to further enhance usage experience.</p>\n",
        "student_name": "Jakub Senko",
        "code_url": "https://blog.phpbb.com/2017/08/24/google-summer-of-code-2017-advertisement-management/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5441173539782656/"
      },
      {
        "title": "Implementation of storage service",
        "short_description": "My goal is to split the filesystem service into one additional storage service to allow developers to create extensions which change the storage...",
        "description": "<p>My goal is to split the filesystem service into one additional storage service to allow developers to create extensions which change the storage engine, to store all upload files and backups in cloud storage services like Amazon S3, Azure, ftp, etc.</p>\n",
        "student_name": "rubencm",
        "code_url": "https://gist.github.com/rubencm/1ebb24781a643523a506fc31b7bc8abd",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/4922106072530944/"
      }
    ],
    "2018": [
      {
        "title": "Improve storage service",
        "short_description": "Improvements and new features for the storage system, and update of the flysystem storage extension.",
        "description": "<p>Improvements and new features for the storage system, and update of the flysystem storage extension.</p>\n",
        "student_name": "rubencm",
        "code_url": "https://gist.github.com/rubencm/d318b0a4b0b09aafdbc3e4bbd5c230a2",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/6662466079555584/"
      },
      {
        "title": "User Mentions",
        "short_description": "This project is intended to add the ability to mention board users in forum posts with “@” so that they receive notifications and their names are...",
        "description": "<p>This project is intended to add the ability to mention board users in forum posts with “@” so that they receive notifications and their names are properly highlighted in topics.</p>\n",
        "student_name": "Igor Lavrov (LavIgor)",
        "code_url": "https://github.com/phpbb/phpbb/pull/5225",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/6052955258093568/"
      }
    ]
  },
