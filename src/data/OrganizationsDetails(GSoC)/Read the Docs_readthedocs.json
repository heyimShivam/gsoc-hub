  "projects": {
    "2018": [
      {
        "title": "Refactor & Improve search code",
        "short_description": "This project is to improve the search functionality of Read the Docs so that the users of readthedocs can get relevant information from the search....",
        "description": "<p>This project is to improve the search functionality of Read the Docs so that the users of readthedocs can get relevant information from the search. Moreover, rewriting the code in order to use latest version of Elasticsearch and officially supported library.\nThis will help the platform developer to maintain the search code easily also help the user to get more useful search result.</p>\n",
        "student_name": "Safwan Rahman",
        "code_url": "https://medium.com/@safwan.rahman/gsoc-wrap-up-read-the-docs-search-improvement-62428097ece1",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/4656335308193792/"
      }
    ],
    "2019": [
      {
        "title": "Search Update & In-Doc Search UI",
        "short_description": "Searching is an important part of Read the Docs.\nThis project aims to implement new features on the existing search backend, which are as follows:\n...",
        "description": "<p>Searching is an important part of Read the Docs.\nThis project aims to implement new features on the existing search backend, which are as follows:</p>\n<ul>\n<li><strong>In-Doc Search UI</strong>: Creating an Sphinx extension which provides a full-page search UI with \"search as you type\" capability.</li>\n<li><strong>Multiple Hits Per Search Result</strong>: Support results from sections of the docs.</li>\n<li><strong>Code Search</strong>: Index sphinx domain objects properly and improve the UI/UX around its search.</li>\n<li><strong>Search Analytics</strong>: Provide search analytics to the project admins.</li>\n</ul>\n",
        "student_name": "Vaibhav (dojutsu-user)",
        "code_url": "https://gist.github.com/dojutsu-user/16e429173de35a5aced04b1f44f07321",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/6376055881859072/"
      },
      {
        "title": "Read the Docs Autobuild Docs for Pull Requests",
        "short_description": "This project involves  automatically building docs for Pull Requests in GitHub repositories that Read the Docs users have. This will include modeling...",
        "description": "<p>This project involves  automatically building docs for Pull Requests in GitHub repositories that Read the Docs users have. This will include modeling pull requests as versions, building an integration with Github, storing the generated docs in long term storage, Deleting pull request Docs when merged or after a certain period of time and many other possibilities that might arise while working on this.</p>\n",
        "student_name": "Maksudul Haque(saadmk11)",
        "code_url": "https://blog.readthedocs.com/building-docs-for-pull-requests/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/6239099793440768/"
      }
    ]
  },
