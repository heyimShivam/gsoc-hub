  "projects": {
    "2016": [
      {
        "title": "Add \"hardware mixing\" support to HDMI2USB firmware",
        "short_description": "This project aims at the development of a hardware mixer block in the HDMI2USB firmware which can implement mixing of the two input pixel stream as...",
        "description": "<p>This project aims at the development of a hardware mixer block in the HDMI2USB firmware which can implement mixing of the two input pixel stream as per the mask information. This suitable mask can be varied dynamically to create fading and wipe effects using the hardware block at a given pixel rate.</p>\n",
        "student_name": "ssk1328",
        "code_url": "https://shashankgangrade.wordpress.com/gsoc-final/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5448350430134272/"
      },
      {
        "title": "FX2 firmware support for FTDI emulation",
        "short_description": "Adding firmware support for FX2 so that libftdi drivers can be used to talk to the device",
        "description": "<p>Adding firmware support for FX2 so that libftdi drivers can be used to talk to the device</p>\n",
        "student_name": "Sab",
        "code_url": "https://docs.google.com/spreadsheets/d/11g_5kHMvrNSwYT-GBX_GsV2IUszO5mB3-n3uUau9KUg/edit?usp=sharing",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5573940374142976/"
      }
    ],
    "2017": [
      {
        "title": "USB Sound Capture",
        "short_description": "This project will add USB audio to the HDMI2USB firmware. It will allow the FX2 USB module to present itself as an audio device as well as the...",
        "description": "<p>This project will add USB audio to the HDMI2USB firmware. It will allow the FX2 USB module to present itself as an audio device as well as the current video device. USB audio is a much needed addition as it reduces the number of required cables when setting up a presenter’s laptops. It also has applications for other sources as many HDMI capable devices send their audio over that HDMI connection. Note that this does not include the HDMI capture side of the audio.</p>\n",
        "student_name": "Kyle Robbertze",
        "code_url": "https://gsoc.paddatrapper.me/post/gsoc-project-report-usb-sound-capture",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6047262144724992/"
      },
      {
        "title": "Convert the JPEG encoder from VHDL to  Migen/MiSoC",
        "short_description": "This aim of this project is to convert the JPEG encoder from VHDL to the Migen/Misoc . Different modules of the encoder are been implemented using...",
        "description": "<p>This aim of this project is to convert the JPEG encoder from VHDL to the Migen/Misoc . Different modules of the encoder are been implemented using the python libraries(Migen) and as a minor modification to the initial architecture of the encoder which include FSM machine for passing the data from one submodule to the other , this include Ready-Valid Handshake Protocol (Streaming Version of the JPEG encoder) for doing so. All the major work regarding the issue will be done under in the HDMI2USB-litex-firmware repository based on the issue #31[HDMI2USB] Convert the JPEG encoder from VHDL to Migen / Misoc.</p>\n",
        "student_name": "Ishan Bansal",
        "code_url": "https://gsoc2017blog.wordpress.com/2017/08/27/gsoc-final-report/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5197434682605568/"
      }
    ],
    "2018": [
      {
        "title": "Bit Error Ratio Analyzer using LiteX",
        "short_description": "Bit error ratio testers are used to test the quality of signal trans-reception. They are routinely used to test boards with high-speed serial links...",
        "description": "<p>Bit error ratio testers are used to test the quality of signal trans-reception. They are routinely used to test boards with high-speed serial links and tune parameters so that the medium fidelity is maximized. Integrated Bit Error Rate Tester (IBERT) LogiCore is one such tool from Xilinx and is designed for testing the physical layer transmission (PMA specifically). This project aims to develop an open source equivalent of the Xilinx LogiCore which incorporates most features as detailed in its datasheet. Independent modules will be coded in python using Migen framework and libraries from LiteX will be used to prepare the communication modules, bridges, and host connections.</p>\n",
        "student_name": "Harsh Gugale",
        "code_url": "https://gsoc2018blog.blogspot.com/2018/08/gsoc-2018-final-report.html",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5655296449970176/"
      },
      {
        "title": "Create a generic debug interface for soft-CPU core (OR1K) and connect it to GDB",
        "short_description": "This project aims to create a run-control debug system for soft CPU core (OR1K) and add GDB to the system using Open SoC Debug Project. Run-control...",
        "description": "<p>This project aims to create a run-control debug system for soft CPU core (OR1K) and add GDB to the system using Open SoC Debug Project. Run-control debugging, also known as breakpoint debugging or “stop-and-stare” debugging is the most common way of finding problems in the code. Using GNU Debugger (GDB) breakpoints can be set in the program, and one can read register or memory values, print stack traces, and much more.</p>\n",
        "student_name": "Shivam Aggarwal",
        "code_url": "https://wp.me/p9SnJX-1K",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/4658010479656960/"
      }
    ],
    "2019": []
  },
