      {
        "title": "Add GeoJSON interoperability to QtLocation",
        "short_description": "The goal of this project is to make QtLocation interoperable with GeoJSON (https://tools.ietf.org/html/rfc7946). This translates into adding support...",
        "description": "<p>The goal of this project is to make QtLocation interoperable with GeoJSON (<a href=\"https://tools.ietf.org/html/rfc7946\" target=\"_blank\">https://tools.ietf.org/html/rfc7946</a>). This translates into adding support for loading geometries from GeoJSON and exporting geometries to GeoJSON, as well as adding the required features to QtLocation to reach feature-parity with GeoJSON.</p>\n",
        "student_name": "Julian Sherollari",
        "code_url": "https://codereview.qt-project.org/#/q/owner:%22Julian+Sherollari%22+,n,z",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5180918117433344/"
