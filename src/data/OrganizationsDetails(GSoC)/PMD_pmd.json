  "projects": {
    "2017": [
      {
        "title": "Bringing Object-Oriented Metrics to PMD",
        "short_description": "Object-Oriented (OO) metrics synthesize characteristics of OO entities (classes, methods) and of their relations, and if combined efficiently, can...",
        "description": "<p><em>Object-Oriented (OO) metrics</em> synthesize characteristics of OO entities (classes, methods) and of their relations, and if combined efficiently, can reveal to the programmer some of the design antipatterns that are specific to OO-systems. This project aims to provide PMD rule developers with straightforward utility methods that calculate metrics, thus enabling them to target systemic design flaws, through the creation of a <em>dedicated metrics framework.</em></p>\n",
        "student_name": "Clément Fournier",
        "code_url": "https://gist.github.com/oowekyala/819016d5cc9509f88034bbd6bcb986c9",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6505217864499200/"
      },
      {
        "title": "Complete type resolution for Java",
        "short_description": "Currently, PMD's support for type resolution with the Java language is limited. This severely restricts the code inspection rules which could be...",
        "description": "<p>Currently, PMD's support for type resolution with the Java language is limited. This severely restricts the code inspection rules which could be implemented. This project aims to fix this by finishing the implementation and providing complete type resolution for all AST nodes of interest.</p>\n",
        "student_name": "Bendegúz Nagy",
        "code_url": "https://github.com/pmd/pmd/commits/master?author=WinterGrascph",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5987510559703040/"
      }
    ],
    "2018": [
      {
        "title": "Automated regression tests against real-world projects",
        "short_description": "A regression testing tool is created to ensure that new problems and unexpected behaviors will not be introduced to PMD project after fixing an issue...",
        "description": "<p>A regression testing tool is created to ensure that new problems and unexpected behaviors will not be introduced to PMD project after fixing an issue , and new rules can work as expected.</p>\n",
        "student_name": "Binguo Bao",
        "code_url": "https://gist.github.com/djydewang/37aa8b99fb56889dc4b570aaa62d541a",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5149325545963520/"
      }
    ]
  },
