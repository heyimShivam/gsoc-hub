  "projects": {
    "2018": [
      {
        "title": "High Performance Web Server with Fibers",
        "short_description": "The aim of this project is to re-implement Warp with Fibers to demonstrate the effectiveness of Fibers. To complete that, the following goals need to...",
        "description": "<p>The aim of this project is to re-implement Warp with Fibers to demonstrate the effectiveness of Fibers. To complete that, the following goals need to be reached:</p>\n<ol>\n<li>Implement non-blocking I/O support for Fibers.</li>\n<li>Recognize the parts of code related with I/O and threads, and rewrite them with Fibers</li>\n<li>Write a benchmark for the performance of Warp.</li>\n<li>Perform a detailed analysis and tune performance.</li>\n</ol>\n",
        "student_name": "Jitian Deng",
        "code_url": "https://github.com/ouromoros/eta-gsoc",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/6137374182473728/"
      },
      {
        "title": "Purity and Nullability Analysis",
        "short_description": "I propose to work on a tool that, given JVM bytecode, decides for each method, whether it performs an effectful computation (including IO, global...",
        "description": "<p>I propose to work on a tool that, given JVM bytecode, decides for each method, whether it performs an effectful computation (including IO, global variable mutation etc.), or it is referentially transparent, that is it yields the same result everytime it is called with same arguments. Such functions are called 'pure functions'. The tool is also supposed to provide information about whether the return type can be the special <code>null</code> value, requiring a <code>Maybe a</code> during Eta-interop. Automated analysis for such data can simplify the development process, by enabling an ffi-generator to generate bindings for Java , ideally without requiring any manual input from the developer. Since the project is mostly exploratory, the analysis is intended to be conservative, but never wrong, in the sense that it should not recommend a return type of <code>a</code> for a function that may return <code>null</code>, but may recommend <code>Maybe a</code> for a function that never returns <code>null</code>. But the aim is to, of course, minimize the number of such cases.</p>\n",
        "student_name": "Mriganka B R Chowdhury",
        "code_url": "https://mbrc12.github.io/blog/posts/2018-08-06-2.html",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5192733304029184/"
      }
    ]
  },
