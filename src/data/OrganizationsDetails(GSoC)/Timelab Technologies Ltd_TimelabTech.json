  "projects": {
    "2016": [
      {
        "title": "Time Series Simulator Using Impulse Responses",
        "short_description": "The purpose of this project is to interpret the timing behavior of light curves in terms of impulse responses, and in doing so, build a common tool...",
        "description": "<p>The purpose of this project is to interpret the timing behavior of light curves in terms of impulse responses, and in doing so, build a common tool for astronomers to analyze X-ray time series. Impulse responses are useful as they enable us to link the variability properties with emission properties and subsequently, observe the X-ray spectrum.</p>\n<p>The end-goal of this project is to implement a fully-working time series simulator with working unit tests and complete documentation. The end-goal also includes comparing the properties of simulated time series against real data.</p>\n",
        "student_name": "Usman Mahmood Khan",
        "code_url": "http://usmanwardag.github.io/gsoc/stingray/2016/08/14/GSOC-Wrap-Up.html",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5685057352105984/"
      },
      {
        "title": "An integrated graphical environment for visual inspection and filtering of time-series for astronomy",
        "short_description": "The project involves building an integrated graphical environment for visual inspection filtering of time-series for astronomy . With the progress of...",
        "description": "<p>The project involves building an integrated graphical environment for visual inspection filtering of time-series for astronomy . With the progress of data science industry, it is very crucial to have advances in data visualization tools.Most of the existing tools for data analysis lack in efficient data exploration due to lack of graphical user interface . Displaying data graphically in form of plots, helps in quickly viewing the most important aspects of the given data and helps in finding the patterns and trends hidden in the Data . Project involves performing series of operations on the data , and produce interactive plots out of it , for analysis .</p>\n",
        "student_name": "dash95",
        "code_url": "https://github.com/StingraySoftware/dave/wiki/Google-Summer-of-Code-2016",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5076271507701760/"
      },
      {
        "title": "Library of Time Series methods",
        "short_description": "This project aims to implement a single, comprehensive library for Time Series analysis with a major focus on the analysis of data received from...",
        "description": "<p>This project aims to implement a single, comprehensive library for <em>Time Series</em> analysis with a major focus on the analysis of data received from accreting  systems such as black holes and neutron stars. Time series analysis is fun but challenging area of Machine Learning. This project aims to reduce the barrier of upfront new researchers to use the software extensively for their purpose.</p>\n",
        "student_name": "OrkoHunter",
        "code_url": "https://docs.google.com/document/d/1CCEUUqFuziigu2c65rCKNATW33pAM_GBA5XPMewGniU",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/4644645548064768/"
      }
    ]
  },
