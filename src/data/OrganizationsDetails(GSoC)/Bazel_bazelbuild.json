  "projects": {
    "2017": [],
    "2019": [
      {
        "title": "Starlark language",
        "short_description": "Starlark language was designed for Bazel. The language has now a specification, 3 implementations (in Java, in Go, in Rust), and is used outside...",
        "description": "<p>Starlark language was designed for Bazel. The language has now a specification, 3 implementations (in Java, in Go, in Rust), and is used outside Bazel.</p>\n<p>The goal of this project is to ensure the different implementations are in sync. This includes creating a common test suite, identifying and resolving corner-cases, suggesting changes to the language specification. It would be useful to compare the performance of the implementations (to find performance issues) and improve the interpreter in Java.</p>\n",
        "student_name": "Marwan Tammam",
        "code_url": "https://docs.google.com/document/d/1NPOxMqUoulye5gyqLpMkonhGjsHzviiMDb29h3nPxSQ/edit?usp=sharing",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/5625060717494272/"
      },
      {
        "title": "Sandboxing on Windows",
        "short_description": "Bazel on Linux already supports various ways to run actions in a sandbox (linux-sandbox, processwrapper-sandbox). We want to support sandboxing on...",
        "description": "<p>Bazel on Linux already supports various ways to run actions in a sandbox (linux-sandbox, processwrapper-sandbox). We want to support sandboxing on Windows by reusing the  DetoursService from BuildXL (<a href=\"https://github.com/Microsoft/BuildXL\" target=\"_blank\">Microsoft Build Accelerator</a>).</p>\n<p>Related issue: <a href=\"https://github.com/bazelbuild/bazel/issues/5136\" target=\"_blank\">https://github.com/bazelbuild/bazel/issues/5136</a></p>\n",
        "student_name": "Rong Jie Loo",
        "code_url": "https://gist.github.com/rongjiecomputer/53a23172369c9fed6718826d19b47831",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/5909024493535232/"
      }
    ]
  },
