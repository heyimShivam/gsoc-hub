    "2019": [
      {
        "title": "Linter for oclif",
        "short_description": "This project aims at adding custom rules for the oclif in TypeScript and Javascript such that\nother developers can create their CLI without any...",
        "description": "<p>This project aims at adding custom rules for the oclif in TypeScript and Javascript such that\nother developers can create their CLI without any hassle and find the small bugs and errors\neasily and effectively. It will reduce the time for the bug fix due to functional errors in code.\nLinter is used to enforce coding standards throughout the codebase</p>\n",
        "student_name": "Moulik Aggarwal",
        "code_url": "https://gist.github.com/moulikcipherX/6e0cef3b0f9401d2dcf5874f5f748c3b",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/5708784796696576/"
      },
      {
        "title": "Extending & Improving Design System React",
        "short_description": "Design System React (short for Lightning Design System for React) is a react implementation of the Salesforce Lightning Design System, which an Open...",
        "description": "<p>Design System React (short for Lightning Design System for React) is a react implementation of the Salesforce Lightning Design System, which an Open Source lightweight, high performance web component framework that powers thousands of apps. \nThis project aims to extend and improve the DSR library, by implementing different design patterns from the SLDS as React components in DSR. \nThe goal of this project is to help non-UI engineers implement highly interactive web applications with ease, by extending the variety of components that are available to them through the DSR library. Adding more variety of components will also help DSR to be useful for a wide range of applications, and make it a go-to React UI library.</p>\n",
        "student_name": "Ashwin S Shenoy",
        "code_url": "https://aswinshenoy.com/gsoc19/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/6193798005129216/"
      }
    ]
  },
