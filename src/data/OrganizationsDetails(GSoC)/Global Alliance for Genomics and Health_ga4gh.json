  "projects": {
    "2016": [
      {
        "title": "GSoC Student Proposal for SMART/FHIR and GA4GH",
        "short_description": "I am submitting  a proposal for integrating SMART/FHIR and GA4GH",
        "description": "<p>I am submitting  a proposal for integrating SMART/FHIR and GA4GH</p>\n",
        "student_name": "Beth2",
        "code_url": "https://drive.google.com/file/d/0BwMrLWyiMI9pQ0Z1U0hmb2tST2M/view?usp=sharing",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/6615272911798272/"
      },
      {
        "title": "Beacon Compliance Suite",
        "short_description": "Main tasks include the following:\n\nthe Beacon project and Beacon Networks project need a Java client to be implemented. The configurable clients...",
        "description": "<p>Main tasks include the following:</p>\n<ol>\n<li>the Beacon project and Beacon Networks project need a Java client to be implemented. The configurable clients should consume the corresponding web services;</li>\n<li>CLI (command line interface) libraries should be developed that would utilize the clients built on the previous step;</li>\n<li>due to release of a new version of the beacon schema (0.3), the BDK (Beacon Development Kit) should be updated accordingly;</li>\n<li>authentication and authorization layers should be added to the updated BDK (using Keycloak);</li>\n<li>an interactive documentation (using Swagger) should be created for the final Beacon API .</li>\n</ol>\n<p>The tasks links for detailed info:</p>\n<p><a href=\"https://github.com/mcupak/beacon-cli/issues/1\" target=\"_blank\">https://github.com/mcupak/beacon-cli/issues/1</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-client/issues/1\" target=\"_blank\">https://github.com/mcupak/beacon-client/issues/1</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-network-cli/issues/1\" target=\"_blank\">https://github.com/mcupak/beacon-network-cli/issues/1</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-network-client/issues/1\" target=\"_blank\">https://github.com/mcupak/beacon-network-client/issues/1</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-java/issues/1\" target=\"_blank\">https://github.com/mcupak/beacon-java/issues/1</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-java/issues/2\" target=\"_blank\">https://github.com/mcupak/beacon-java/issues/2</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-java/issues/5\" target=\"_blank\">https://github.com/mcupak/beacon-java/issues/5</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-java/issues/6\" target=\"_blank\">https://github.com/mcupak/beacon-java/issues/6</a></p>\n<p><a href=\"https://github.com/mcupak/beacon-java/issues/3\" target=\"_blank\">https://github.com/mcupak/beacon-java/issues/3</a></p>\n",
        "student_name": "Voskoboynick",
        "code_url": "https://gist.github.com/artemik/2a985c4a4c604cf6f212463a568ef10c",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5553409088290816/"
      },
      {
        "title": "Building a Better Beacon: Developing Supporting Tools for the Beacon Project",
        "short_description": "With beacons being lit and the specification readily being adopted by organizations all over the world, there is a need for a toolkit which...",
        "description": "<p>With beacons being lit and the specification readily being adopted by organizations all over the world, there is a need for a toolkit which guarantees compliance with the defined beacon API. The toolkit should contain an entire compliance test suite for organizations looking to implement the beacon API, as well as adapters (or protocols for creating adapters) for organizations which want to user their current data for the beacon. My proposed project will implement the toolkit as well as generate more community documentation to further simplify the beacon creation process.</p>\n",
        "student_name": "patmagee",
        "code_url": "https://gist.github.com/patmagee/08b73b93f4be6dbca87406e35cf6d9b0",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/4806214433112064/"
      }
    ],
    "2017": [
      {
        "title": "Improve Structural Variants Support in VCF Validator",
        "short_description": "The VCF (Variant Call Format) is a format for text files, which is generally stored in a compressed manner to make the data retrieval of variants...",
        "description": "<p>The VCF (Variant Call Format) is a format for text files, which is generally stored in a compressed manner to make the data retrieval of variants fast. The data which is redundant is not stored, only the variations are stored. VCF files are used to store all variant types which includes single nucleotide polymorphism (SNP) in a specific position of the genome, short insertions and deletions (INDEL) and structural variants (SV). \nVCF-validator includes various checks to ensure that the VCF file is consistent. It is based on a formal grammar and performs lexical, syntactic, and semantic analysis of the VCF file. It also includes a tool called VCF-debugulator which fixes errors such as the presence of duplicate variants automatically. \nSNPs and INDELs are fully supported in VCF-validator, but the support for SVs is still limited. The aim of this project is to improve the support for structural variants in the validator and the debugulator.</p>\n",
        "student_name": "Anishka Gupta",
        "code_url": "https://gist.github.com/Anishka0107/75d0f6c13ebbe22b1643689683c25a54",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5232335049981952/"
      },
      {
        "title": "VCF Streaming API Server and Specification",
        "short_description": "“Htsget retrieval API spec” [1] is a specification by the Global Alliance for Genomics and Health (GA4GH) for genomics bulk data transfers. This is a...",
        "description": "<p>“Htsget retrieval API spec” [1] is a specification by the <a href=\"http://www.genomicsandhealth.org/\" target=\"_blank\">Global Alliance for Genomics and Health (GA4GH)</a> for genomics bulk data transfers. This is a Streaming API that allows users to query remote services for regions of interest of genomic data, instead of having to download gigabytes of data and filter afterwards. The results are retrieved in formats that can be consumed by widely used bioinformatics tools. The specification currently supports BAM and CRAM formats.<br>\nVariant Call Format (VCF) is the standard for describing genomic variation in bioinformatics. The goal of the project is to extend the specification to support the VCF format and provide an implementation.</p>\n",
        "student_name": "Amila Silva",
        "code_url": "https://gist.github.com/amilamanoj/a3827d91e9915569ee97d9802e394839",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5312337674240000/"
      }
    ]
  },
