  "projects": {
    "2016": [
      {
        "title": "Hardware-accelerated media decoding on Android",
        "short_description": "The goal of this project is to make \"osmo4\" player take advantage of the Android's low level media APIs i.e. MediaCodec APIs by writing a decoding...",
        "description": "<p>The goal of this project is to make \"osmo4\" player take advantage of the Android's low level media APIs i.e. MediaCodec APIs by writing a decoding module for it. This will result in better battery life and less CPU usage.</p>\n<p>Another important goal is to redesign the osmo4 Android App to make it look much better than the current version. It will follow Material Design guidelines and will also come with a redesigned file manager.</p>\n",
        "student_name": "AbdulRauf",
        "code_url": "https://github.com/rauf/gpac/commits/android_osmo4?author=rauf",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/4785383036420096/"
      }
    ],
