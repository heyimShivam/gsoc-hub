  "projects": {
    "2016": [
      {
        "title": "ModSecurity Connector for Apache",
        "short_description": "This connector will create an interface between the Apache Web Server to the libModSecurity. By creating this connector, the target application will...",
        "description": "<p>This connector will create an interface between the Apache Web Server to the libModSecurity. By creating this connector, the target application will be able to apply ModSecurity inspections and actions on Apache Web Server.</p>\n",
        "student_name": "Tahir Ramzan",
        "code_url": "http://tahirramzan.github.io/ModSecurity-apache/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5421656939954176/"
      },
      {
        "title": "ModSecurityv3 IDS connector",
        "short_description": "HTTP checks are mostly done via regex in IDS like Snort. This limits the flexibility to write custom rules to suit one’s needs. This proposal focuses...",
        "description": "<p>HTTP checks are mostly done via regex in IDS like Snort. This limits the flexibility to write custom rules to suit one’s needs. This proposal focuses on making libmodsecurity work for http checks given in snort by replacing them with rules in libmodsecurity. Comparison of speed of parsing in both the cases will also be tested.</p>\n",
        "student_name": "Akhil Koul",
        "code_url": "https://akoul.github.io/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/6206390951477248/"
      },
      {
        "title": "ModSecurity Connector for Node.js",
        "short_description": "libModSecurity (aka ModSecurity v3) is a major rewrite of standalone ModSecurity (v2.x) which have high dependencies on 3rd party project including...",
        "description": "<p>libModSecurity (aka ModSecurity v3) is a major rewrite of standalone ModSecurity (v2.x) which have high dependencies on 3rd party project including Apache. Now the project is splitted into two components namely connectors and core. Where the core is underlying library and connectors are the consumer of this library. This way ModSecurity cores becomes completely independent of underlying web server. In this project we will be extending the support of ModSecurity to Node.js by creating a ModSecurity connector for Node.js. This will provide ModSecurity support to a large community of Node.js developers as there are not many waf available in Node.js.</p>\n",
        "student_name": "m2n",
        "code_url": "https://m2n.me/gsoc/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5866718631034880/"
      }
    ]
  },
