  "projects": {
    "2016": [
      {
        "title": "jQuery Learning Center",
        "short_description": "The goal of this project is to develop a framework for the development and presentation of interactive tutorials in order to provide a full learning...",
        "description": "<p>The goal of this project is to develop a framework for the development and presentation of interactive tutorials in order to provide a full learning experience.</p>\n",
        "student_name": "connor",
        "code_url": "https://gist.github.com/ConnorCartwright/8fb408fbe4d18ac76530c207e5ebf191",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/6439426750152704/"
      },
      {
        "title": "Create a sandbox interface for tests",
        "short_description": "Testings of JavaScript application sometimes include modification of their own environment, such as global/native objects extensions and DOM...",
        "description": "<p>Testings of JavaScript application sometimes include modification of their own environment, such as global/native objects extensions and DOM manipulations. To avoid undesirable side effects, they have to be executed in a clean environment as much as possible.</p>\n<p>Since Intern JavaScript testing framework doesn't have this as the core feature yet, users have to manually reset or sandbox everything they care. The aim of this proposal is to solve this issue by implementing “sandbox interface” to Intern core API and make users get rid of the difficulties.</p>\n<p>The timeline of this proposal includes the following:</p>\n<ul>\n<li>Make friends with Intern's codebase</li>\n<li>Investigate and discuss with my mentors how this feature will be implemented</li>\n<li>Write actual codes</li>\n<li>Fix bugs</li>\n<li>Test and document everything I implemented</li>\n</ul>\n",
        "student_name": "hakatashi",
        "code_url": "https://gist.github.com/hakatashi/fef709268d09fd844e4d13c57a461ea1",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5321045854650368/"
      },
      {
        "title": "Adding UI components to Chassis framework",
        "short_description": "Chassis aims at defining open standards for various CSS/JS libraries and the web in general. \nThe project aims to complete and deliver base styles...",
        "description": "<p>Chassis aims at defining open standards for various CSS/JS libraries and the web in general. \nThe project aims to complete and deliver base styles for at least 5 UI components (e.g. tabs, modals, menus e.t.c) by the end of GSOC 2016. The project makes use of advanced SASS and JS for testing the components integration.</p>\n",
        "student_name": "Nash Vail",
        "code_url": "https://gist.github.com/nashvail/46949066c64578246f79c6b8356427ae",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/6032159965970432/"
      },
      {
        "title": "Bug Hunt",
        "short_description": "jQuery Mobile currently has a large number of open issues (~300). To maintain JQM’s vitality, this backlog should be necessarily cleared. This summer...",
        "description": "<p>jQuery Mobile currently has a large number of open issues (~300). To maintain JQM’s vitality, this backlog should be necessarily cleared. This summer project aims to bring down this number to 50 (fifty) and categorize them in a proper and manageable manner and on the same time handle the communication and response to community both during and after the summer.</p>\n",
        "student_name": "apsdehal",
        "code_url": "https://apsdehal.in/blog/gsoc-16-highlights",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/4870252932366336/"
      },
      {
        "title": "Proposal for commitplease project in jQuery",
        "short_description": "Projects like jQuery and Angular JS are written primarily with javascript and make extensive use of git as their version control system. Using git...",
        "description": "<p>Projects like jQuery and Angular JS are written primarily with javascript and make extensive use of git as their version control system. Using git means that developers write commit messages. Nice and clean commit messages that adhere to an agreed-upon style are very common. So, implementing a way to validate these messages, like the commitplease project, makes a lot of sense. Currently, the commitplease project supports the jQuery style commit messages. Extending its support to the Angular-style ones (and possibly others) is a logical goal.</p>\n",
        "student_name": "all3fox",
        "code_url": "https://all3fox.github.io/2016/08/16/gsoc16-at-commitplease.html",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5841216725843968/"
      },
      {
        "title": "Qunit - Standard reporter interface",
        "short_description": "My project aims to improve the development of testing tools through a common interface for reporters. It is hard because there are already so many...",
        "description": "<p>My project aims to improve the development of testing tools through a common interface for reporters. It is hard because there are already so many tools and each one has its own interface and they will no renounce so easily, but we will try.</p>\n<p>To achieve this we will implement the specification in a quite popular testing framework, Qunit, and then we will try to engage also other people, mainly maintainers of other open source testing solutions.</p>\n<p>This way any one that will build in the future a new testing tool will be encouraged to use this interface, because it is time saving and less code to write, it is in the spirit of code reuse.</p>\n",
        "student_name": "flore77",
        "code_url": "https://flore7seven.wordpress.com/2016/07/16/gsoc2016/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5136916982792192/"
      },
      {
        "title": "A module system for Hammer.js",
        "short_description": "The advantages of organizing a program into several files or modules are similar to authors organizing a book into several chapters and sections. The...",
        "description": "<p>The advantages of organizing a program into several files or modules are similar to authors organizing a book into several chapters and sections. The structure helps people who aren’t yet familiar with the code find what they are looking for and makes it easier for the programmer to keep things that are related close together. This project aims at developing a module system for the wonderful Hammer.js library that is flexible, predictable and extensible in the new ES6 version of javaScript.</p>\n",
        "student_name": "shad0w_",
        "code_url": "https://gist.github.com/arjunkathuria/6b92f8ac5f34a10e001ab30defe05e68",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5160583594770432/"
      }
    ]
  },
