  "projects": {
    "2019": [
      {
        "title": "Observatory Dependency Decoupling",
        "short_description": "PANOPTES Observatory Control System (POCS) use different hardware components and scheduler which are closely connected to main Observatory class....",
        "description": "<p>PANOPTES Observatory Control System (POCS) use different hardware components and scheduler which are closely connected to main Observatory class. Therefore, it makes whole architecture not flexible, and it's problematic to make dynamic adding or removing components. In order, to fix this issue the Dynamic Inversion principle will be used to modify whole architecture for flexible usage of the system.</p>\n",
        "student_name": "Demezhan Marikov",
        "code_url": "https://gist.github.com/ImmortalRabbit/3b03f9f66cafe149244355e14a5e51ff",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/6657530858569728/"
      },
      {
        "title": "Design and Development of Demos and Tools",
        "short_description": "As part of the project, I intend to build simulations and demos along with introductory animations about exoplanets, their descriptions and the...",
        "description": "<p>As part of the project, I intend to build simulations and demos along with introductory animations about exoplanets, their descriptions and the methods used to detect them while highlighting the Transit Light Curve method.\nProposed simulators and demos other than introductory animations:</p>\n<ol>\n<li>Predict the planet characteristics from the drawn/input transit light curve.</li>\n<li>Give a transit light curve and ask the player/user to guess the planet characteristics.</li>\n<li>Read and display actual data from Kepler or other projects and compare predictions made to the actual interpretation of the data.</li>\n<li>Building a differential time lapse tool for various image formats with a focus on FITS (Python).</li>\n</ol>\n",
        "student_name": "Naga Sai Abhinay",
        "code_url": "https://gist.github.com/Abhinay1997/e5bdf2067a0b93681f92d60805d47590",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/6276888710873088/"
      }
    ]
  },
