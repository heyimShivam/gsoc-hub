  "projects": {
    "2017": [
      {
        "title": "Markerless model-based tracker CAD model editor",
        "short_description": "ViSP supports CAD model in .cao format or in .vrml format which are needed for Markerless \nmodel-based tracker module. Currently, the creation of...",
        "description": "<p>ViSP supports CAD model in .cao format or in .vrml format which are needed for Markerless \nmodel-based tracker module. Currently, the creation of .cao model formats, which is a \nhomemade file format, and its corresponding config files has to be done manually. The goal of \nthis project is to automate this process by providing extensive tools to achieve perfect and \nloss-less conversion from existing 3D file formats to .cao and also generation from scratch:</p>\n<p>1) Develop dedicated Blender plugin to edit and convert from classical 3D file format \n(for example .obj) to home-made CAD model file format.</p>\n<p>2) Develop a very simple CAD model viewer and editor that allows to add ViSP MBT \nspecific characteristics to a face or a line such as a label or a level of details (lod).</p>\n",
        "student_name": "Vikas Thamizharasan",
        "code_url": "https://github.com/lagadic/visp_cao_editor/wiki/GSoC-2017-with-ViSP",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6353080996069376/"
      }
    ],
    "2018": [
      {
        "title": "Porting ViSP to Android Devices",
        "short_description": "The objective of my project is to offer the ViSP community an SDK for Android, containing:\n\nBuild scripts\nAdapting existing files\nCreating the...",
        "description": "<p>The objective of my project is to offer the ViSP community an SDK for Android, containing:</p>\n<ul>\n<li>Build scripts</li>\n<li>Adapting existing files</li>\n<li>Creating the Java/JNI Module</li>\n<li>Doxygen Documentation</li>\n<li>Tutorials and Videos</li>\n<li>Sample Executables</li>\n</ul>\n",
        "student_name": "Akshay Sharma-1",
        "code_url": "https://github.com/lagadic/visp/wiki/GSoC-2018:-Porting-ViSP-to-Android-devices",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5711312218750976/"
      },
      {
        "title": "Augmented Reality with ViSP and Unity",
        "short_description": "Computer vision algorithms in ViSP (Visual Servoing Platform) such as pose estimation and tracking have the potential to benefit Augmented Reality...",
        "description": "<p>Computer vision algorithms in ViSP (Visual Servoing Platform) such as pose estimation and tracking have the potential to benefit Augmented Reality (AR) community and could be used for various AR applications in general. In this project, Unity (a cross-platform game engine) is suitably adapted to support augmented reality environment and is integrated with ViSP based april-tag pose estimation and tracking algorithms. Finally, virtual objects are augmented in the Unity scene based on detected pose of april-tag to create AR demonstration. This integration is further extended to markerless model-based tracking using CAD models to support complex AR applications.</p>\n",
        "student_name": "Utkarsh Tripathi",
        "code_url": "https://github.com/lagadic/visp_unity/wiki/GSoC-2018",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/4839768059805696/"
      }
    ]
  },
