  "projects": {
    "2016": [
      {
        "title": "Celluloid - Benchmarking and Performance Improvements",
        "short_description": "Celluloid has gone through a lot of improvements since v0.13. This has somehow affected the performance. The aim of my project primarily is to create...",
        "description": "<p>Celluloid has gone through a lot of improvements since v0.13. This has somehow affected the performance. The aim of my project primarily is to create a benchmarking suite which will be used to tune performance optimizations. The benchmarking suite will cover all the features of Celluloid.\nFurther I will create benchmarking suite for Reel.</p>\n<p>The value of this project is immense to the Celluloid community as it will help us refactor and improve the performance drastically before the 1.0 release of Celluloid.</p>\n",
        "student_name": "Prathmesh Ranaut",
        "code_url": "https://github.com/celluloid/GSoC/blob/master/reports/2016-performance.md",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/6658547928530944/"
      },
      {
        "title": "Celluloid - Adding new features to Reel",
        "short_description": "Reel is Celluloid::IO native, evented server which serves as bare-bones for http and webSocket server providing functionality such as Connection...",
        "description": "<p>Reel is Celluloid::IO native, evented server which serves as bare-bones for http and webSocket server providing functionality such as Connection Management and Multithreading , Fault Tolerance. This project aims to extend Reel by adding new important features such as Session handler,Multi-part parser, and bringing Reel up to HTTP/2 standard.</p>\n",
        "student_name": "Pulkit Bhatia",
        "code_url": "https://github.com/celluloid/GSoC/blob/master/reports/2016-reel_features.md",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5679493490409472/"
      },
      {
        "title": "Extract ECell",
        "short_description": "Prepare the existing ECell code for public release.",
        "description": "<p>Prepare the existing ECell code for public release.</p>\n",
        "student_name": "benzrf",
        "code_url": "https://github.com/celluloid/GSoC/blob/master/reports/2016-ecell_extraction.md",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5079450320371712/"
      }
    ]
  },
