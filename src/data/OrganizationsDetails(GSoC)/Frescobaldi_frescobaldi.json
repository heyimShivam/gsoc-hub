  "projects": {
    "2017": [
      {
        "title": "Improve Frescobaldi Export to MusicXML",
        "short_description": "Frescobaldi is an awesome software to write and manipulate music sheets using Lilypond notation. However, it fails in (properly) providing a really...",
        "description": "<p>Frescobaldi is an awesome software to write and manipulate music sheets using Lilypond notation. However, it fails in (properly) providing a really important feature: exporting to MusicXML. MusicXML notation is an important format adopted for many score writing programs, music OCR and sequencers. Currently, there is a simple support for exporting scores to MusicXML, but the coverage is limited and is not able to export complex projects or to understand different notations to describe the same musical score.</p>\n",
        "student_name": "Felippe Roza",
        "code_url": "https://github.com/wbsoft/frescobaldi/wiki/GSoC-2017:-MusicXML-Export",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6407706269188096/"
      },
      {
        "title": "Proposal for Add Support for Version Control (Git)",
        "short_description": "Inside this proposal, I introduce my project goals of GSoC 2017 and bring out a tentative timeline to achieve them.  To make sure I can finish it in...",
        "description": "<p>Inside this proposal, I introduce my project goals of GSoC 2017 and bring out a tentative timeline to achieve them.  To make sure I can finish it in this summer, I focus on the basic features.</p>\n",
        "student_name": "Xin Wen",
        "code_url": "https://github.com/wbsoft/frescobaldi/wiki/GSoC-2017:-Git-Support-(final-report)",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6285598469914624/"
      }
    ]
  },
