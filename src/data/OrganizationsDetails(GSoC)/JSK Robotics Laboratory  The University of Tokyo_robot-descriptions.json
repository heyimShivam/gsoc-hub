  "projects": {
    "2016": [],
    "2017": [
      {
        "title": "Knowledge and Learned Model Exchange Between Robotic Agents using openEASE",
        "short_description": "In this proposal, I propose a solution for using openEASE as a knowledge bridge between robots. For this, I aim to implement a module in openEASE...",
        "description": "<p>In this proposal, I propose a solution for using openEASE as a knowledge bridge between robots. For this, I aim to implement a module in openEASE called openEASEclient (oeClient). This module will make robots connect to openEASE using web sockets and services without a need of web front-end. This module will, also, offer SWI-Prolog predicates as API so that robots that have KnowRob available can easily interface. After the implementation and testing of oeClient, I will try to exchange static ontologies between PR2s. Then, I conductsome grasp learning experimentusing EULisp. The data gained from these experiments will be used to train models using learning modules in KnowRob. After validation of learned models, these models will be transferred to PR2 in Bremen using oeClient.\nFinally, I will test the learned models with PR2 in Bremen and validate the success of the implemented methodology.</p>\n",
        "student_name": "Asil Kaan Bozcuoglu",
        "code_url": "https://gist.github.com/asilx/db597257e272e958a3b15243f2e1f451",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5660367464169472/"
      },
      {
        "title": "Integrating FCL for collision detection",
        "short_description": "The proposal firstly introduces my previous experience and then give a detailed idea of my plan for the gsoc project.",
        "description": "<p>The proposal firstly introduces my previous experience and then give a detailed idea of my plan for the gsoc project.</p>\n",
        "student_name": "Yisha",
        "code_url": "http://yswhynot.github.io/subpage/projects/gsoc.html",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5496984223875072/"
      }
    ],
    "2018": [
      {
        "title": "EusLisp more Common",
        "short_description": "Adding Common Lisp functionalities to EusLisp and improving existing ones",
        "description": "<p>Adding Common Lisp functionalities to EusLisp and improving existing ones</p>\n",
        "student_name": "Éricles Lima",
        "code_url": "https://ericlesaquiles.github.io/euslisp/2018/08/12/End-of-GSoC-Project.html",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5009622138093568/"
      },
      {
        "title": "Integration of PCL to ROS",
        "short_description": "The jsk-pcl-ros library is widely used for visualizing point cloud data from Microsoft Kinect Camera to ROS (Robot Operating System). We have used...",
        "description": "<p>The jsk-pcl-ros library is widely used for visualizing point cloud data from Microsoft Kinect Camera to ROS (Robot Operating System). We have used Microsoft Kinect camera for visualizing robot workspace to Virtual Reality (HTC Vive). This work seems very interesting and also similar to jsk-pcl-ros integration work. I am excited to contribute to open source community for the pcl-ros integration.</p>\n",
        "student_name": "Sanket Gaurav",
        "code_url": "https://github.com/sanketrahul/GSoC18_Sanket/blob/master/README.md",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5926045819600896/"
      }
