  "projects": {
    "2019": [
      {
        "title": "Build tools that bridge OpenAPI and gRPC",
        "short_description": "Creating APIs should be as easy as writing a “Hello World” program. Therefore, the Google APIs team is\nworking on different tools to accomplish that...",
        "description": "<p>Creating APIs should be as easy as writing a “Hello World” program. Therefore, the Google APIs team is\nworking on different tools to accomplish that goal. One of those tools is gnostic which converts JSON or\nYAML OpenAPI descriptions to equivalent Protocol Buffer specifications.\nThis project idea aims at creating a plugin for gnostic that generates a Protocol Buffer specification that\ncan then be used to generate a gRPC API.</p>\n",
        "student_name": "Lorenz Hofmann-Wellenhof",
        "code_url": "https://medium.com/@lorenzhofmann.w/6-useful-things-i-learned-from-gsoc-1738c7471a90",
        "project_url": "https://summerofcode.withgoogle.com/archive/2019/projects/5019228334194688/"
      }
