{
  "name": "MediaPipe",
  "image_url": "https://lh3.googleusercontent.com/WRv3Ylxmbfpn_uG9BwUj5j3d6OqT3yavzflhOzFU1peN48OM9hGctXhKup2C1ansJiCm23WZ5pUe6oeUtn6Mn-OTpefqbTrATQfp9YpTAbHD",
  "image_background_color": "#ffffff",
