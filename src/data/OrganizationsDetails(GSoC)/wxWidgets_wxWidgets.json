  "projects": {
    "2017": [
      {
        "title": "Support multi-touch gestures",
        "short_description": "The goal of this project is to generate wxWidgets events for the multi-touch gestures recognized by the underlying system and, possibly, also the raw...",
        "description": "<p>The goal of this project is to generate wxWidgets events for the multi-touch gestures recognized by the underlying system and, possibly, also the raw touches which compose them. But it's adding support for the high level events, such as \"zoom\", \"pan\" or \"rotate\" which is the most important part of this project.</p>\n",
        "student_name": "Prashant Kumar",
        "code_url": "https://github.com/wxWidgets/wxWidgets/compare/master...prashantkn94:SOC2017_GESTURES",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5379891201572864/"
      },
      {
        "title": "wxWebView JavaScript Integration",
        "short_description": "wxWebView currently provides a simple RunScript() function for running JavaScript. However in many cases it would be preferable have access to a...",
        "description": "<p>wxWebView currently provides a simple RunScript() function for running JavaScript. However in many cases it would be preferable have access to a return value, or even to call C++ from the JavaScript. This project would aim to provide at least basic functionality for accessing JavaScript values. An API would be required that ensures uniform behaviour across the different backends. Before applying for this project please contact the wx-dev mailing list as further research is required.</p>\n",
        "student_name": "Jose Lorenzo",
        "code_url": "https://docs.google.com/document/d/1oA-lPdjwPWgWehhgSTNcZR1fL_z2ds8zgGY9QjLEwu4/edit?usp=sharing",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6201193772613632/"
      }
    ]
  },
