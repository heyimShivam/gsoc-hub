    "2018": [
      {
        "title": "Increasing Backend Test Coverage",
        "short_description": "The aim is to increase the test coverage around the backend rails api codebase. Right now it has around 45% coverage. I aim to improve it by making...",
        "description": "<p>The aim is to increase the test coverage around the backend rails api codebase. Right now it has around 45% coverage. I aim to improve it by making the unit test coverage at least 85+ and also write integration tests using RSpec and Capybara. I also plan to start on the Rails Upgrade once the test suite is up and running.I plan to go one directory after the other and gradually covering the whole codebase to have a good test coverage.</p>\n",
        "student_name": "gaurav rakheja",
        "code_url": "https://docs.google.com/document/d/12anRdtdsqLtbBKLw0bqDX-T4BVjQ8GhA6IzltwF6FCk/edit?usp=sharing",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/6218246403391488/"
      }
