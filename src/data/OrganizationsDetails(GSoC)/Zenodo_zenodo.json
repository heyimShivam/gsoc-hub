  "projects": {
    "2017": [
      {
        "title": "Research Data Metadata Extraction",
        "short_description": "As a graduate student, I know how painful but crucial to manage research assets. It is exciting to see Zenodo as an open source public platform and...",
        "description": "<p>As a graduate student, I know how painful but crucial to manage research assets. It is exciting to see Zenodo as an open source public platform and aims to improve the life of researchers.</p>\n<p>Metadata extraction is a challenging problem. I have used many different research resource management tools (e.g., Zotero, Melendy, Papers etc.), which partially solves the problem but is far from perfect. And I often end up writing ad-hoc scripts for my demands.</p>\n<p>It is exciting to see Zenodo as an open platform to tackle these problems and benefit many researchers.</p>\n",
        "student_name": "Xiao Meng",
        "code_url": "https://gist.github.com/xiaom/106b9d111726cc99017b7efe7aead01c",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/5308486699188224/"
      },
      {
        "title": "Zenodo Research Profile",
        "short_description": "Zenodo is a great initiative for researchers and invenio is a collection of wonderful APIs. I have chosen this project because it targets every...",
        "description": "<p>Zenodo is a great initiative for researchers and invenio is a collection of wonderful APIs. I have chosen this project because it targets every researcher and one of the basic and immediate requirements of the user from such a beautiful platform. It would also promote zenodo as researchers will start sharing their zenodo profiles in social media.</p>\n",
        "student_name": "jainaman224",
        "code_url": "https://docs.google.com/document/d/1_ohQqpsYx7PlUhT8CqINVt57bydy15SCl995JkMIkUY/edit?usp=sharing",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6248952064114688/"
      }
    ]
  },
