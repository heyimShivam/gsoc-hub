  "projects": {
    "2016": [
      {
        "title": "Physics Simulations",
        "short_description": "This mobile application is targeted at school and university students studying Physics.\nThe application would present various physics simulations to...",
        "description": "<p>This mobile application is targeted at school and university students studying Physics.\nThe application would present various physics simulations to choose from. These simulations will range from basic simulations like spring and pendulum simulation to complex simulations like collisions. Once the user selects a simulation, they will see the simulation animating in real time. The user can also interact with the simulations by providing touch input, dragging objects or changing parameters like gravity, length (of pendulum, string), etc.\nAs studies indicate, students are more interested to learn the concepts of Physics by actually seeing them in a tangible form in a lab, than studying the concepts in a classroom.</p>\n",
        "student_name": "Costin Giorgian",
        "code_url": "https://github.com/BuildmLearn/Physics-Simulations/commits/master?author=costinpapuc",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/5505373637181440/"
      },
      {
        "title": "mConference Framework",
        "short_description": "The 'mConference Framework' project aims at developing an Android Framework which allows organizers to create apps for conferences and events. Using...",
        "description": "<p>The 'mConference Framework' project aims at developing an Android Framework which allows organizers to create apps for conferences and events. Using this framework, the organizers can create apps for any event, conference or meetup by creating and adding data in the configuration file (XML) from a static webpage.</p>\n",
        "student_name": "Jai Agarwal",
        "code_url": "https://github.com/BuildmLearn/mConference-Framework/commits/master?author=jaiagarwal",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/4617854347378688/"
      },
      {
        "title": "University Campus Portal (UCP)",
        "short_description": "THE PROBLEM - \nMany universities do not have a place online for student-student and student-faculty interactions. Some universities do post results,...",
        "description": "<p>THE PROBLEM - \nMany universities do not have a place online for student-student and student-faculty interactions. Some universities do post results, notices etc. on their websites, but it's not easily accessible, and there is no way to notify the students when these uploads are done. Interaction amongst various student bodies, clubs etc. are done through Facebook/ Google groups, which is very inefficient. There is a need for a common platform that can incorporate these things</p>\n<p>The idea is to develop a Free &amp; Open source Web application for Universities. Any university should be able to easily deploy this web app on their servers. The platform will provide the following features</p>\n<p>Discussion Forums : A place for students and professors to have discussions.</p>\n<p>News : A way for the administration to push relevant news to the students</p>\n<p>Events: A way for both Faculty and the students to post information about events happening around the campus</p>\n<p>Academic notices: These includes exam schedule, time tables and results.</p>\n<p>Recruitment Drives: A place where students get to see the placements and internship offers, their eligibility criteria and also a way to apply to them by submitting their resumes.</p>\n",
        "student_name": "Pranav Tiwari",
        "code_url": "https://github.com/BuildmLearn/University-Campus-Portal-UCP/commits/master?author=pranav15197",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/4662615959666688/"
      },
      {
        "title": "Improve existing BuildmLearn Toolkit app and add new templates to it.",
        "short_description": "BuildmLearn Toolkit app is an easy-to-use android app that helps the users make another mobile apps without any knowledge of android application...",
        "description": "<p>BuildmLearn Toolkit app is an easy-to-use android app that helps the users make another mobile apps without any knowledge of android application development. It helps creating mobile application with various functionality and allows teachers to input their custom content.</p>\n<ul>\n<li>Develop Video Collection, Comprehension, Math the following and Dictation templates with simulators.</li>\n<li>Implement the feature of creation of APKs with unique android application id.</li>\n<li>Add material designs in all the eight templates.</li>\n</ul>\n",
        "student_name": "Anupam Das",
        "code_url": "https://github.com/opticod/GSoC-16-Work-Report/blob/master/README.md",
        "project_url": "https://summerofcode.withgoogle.com/archive/2016/projects/4936867338256384/"
      }
    ]
  },
