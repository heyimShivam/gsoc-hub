  "projects": {
    "2018": [
      {
        "title": "Communication Plugin Improvement",
        "short_description": "The purpose of this project is to improve the communication plugin by adding more protocols in it such as VRPN, serial bus communication, and also...",
        "description": "<p>The purpose of this project is to improve the communication plugin by adding more protocols in it such as VRPN, serial bus communication, and also improve the way it works.</p>\n<p>Communication plugins are used in SOFA to send and receive data. Currently, two protocols are implemented in SOFA - OSC, and ZMQ. Communication plugin can be improved further by introducing new protocols and optimizing them. This project specifically deals with the introduction of 2 new protocols namely - VRPN and Serial Bus.</p>\n",
        "student_name": "Rupesh Harode",
        "code_url": "https://gist.github.com/firedranzer/d1bd41fd55a12be8b0777d3aec48ca2e",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/5266077789454336/"
      },
      {
        "title": "Proposal for GSoC",
        "short_description": "The objective of this project is to create an open-source plugin for SOFA building an interface with the open-source library Pulse. This engine...",
        "description": "<p>The objective of this project is to create an open-source plugin for SOFA building an interface with the open-source library Pulse. This engine provides comprehensive models for the human physiology.</p>\n<p>The coupling will lead to an interface which will model parts of the human physiology in addition to providing simulation data of various components, varying with time.</p>\n",
        "student_name": "Manan-1",
        "code_url": "https://medium.com/@jn.manan25/developer-at-google-summer-of-code-18-with-inria-foundation-sofa-and-pulse-da09100504d1",
        "project_url": "https://summerofcode.withgoogle.com/archive/2018/projects/6328905430466560/"
      }
    ]
  },
