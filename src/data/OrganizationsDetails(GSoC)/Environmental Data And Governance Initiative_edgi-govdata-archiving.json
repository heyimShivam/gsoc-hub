    "2017": [
      {
        "title": "Data Visualization of Archived Content",
        "short_description": "The purpose of this project is to develop a set of visually impactful and meaningful models that allow users to easily visualize the changes archived...",
        "description": "<p>The purpose of this project is to develop a set of visually impactful and meaningful models that allow users to easily visualize the changes archived by EDGI.</p>\n",
        "student_name": "Harsh Baid",
        "code_url": "http://harshbaid.com/blog/2017/working-with-edgi/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/6462216651931648/"
      },
      {
        "title": "Identifying and prioritizing important website changes using learning algorithms",
        "short_description": "The project goal is to utilise machine learning algorithms to identify changes on government agency websites which are worth reviewing.\nThe ignorant...",
        "description": "<p>The project goal is to utilise machine learning algorithms to identify changes on government agency websites which are worth reviewing.</p>\n<p>The ignorant and disparaging stand of the new U.S administration on environmental issues like global warming, air pollution etc. has led to panic as federal agencies gradually make the ocean of scientific data on government servers inaccessible to the public.</p>\n<p>The project will attempt to tackle the aforementioned issue and fill the following needs:</p>\n<p>1.Filter out insignificant changes (which may be a major share of all changes) to webpages, and thus, eliminate the need to spend time reviewing useless information.</p>\n<p>2.Direct analysts to important changes on active websites which will help them to efficiently document and analyze relevant information.</p>\n",
        "student_name": "Janak Raj Chadha",
        "code_url": "https://envirodatagov.org/google-summer-code-2017-web-monitoring-project-janak-raj-chadha/",
        "project_url": "https://summerofcode.withgoogle.com/archive/2017/projects/4910480938237952/"
      }
    ]
  },
